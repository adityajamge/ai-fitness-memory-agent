# AI Fitness Memory Agent — local development configuration
#
# Copy to `.env` and edit. `.env` is gitignored; this template is not.
#   cp .env.example .env
#
# Loaded automatically by engine/config.py when python-dotenv is installed
# (`pip install -e . --group dev`), and by the root conftest.py so tests see the same
# configuration the app does. Real environment variables always win over this file, so
# `DATABASE_URL=... pytest` still overrides what is written here.
#
# In production (ECS Express Mode) there is no .env — the task definition supplies these as
# real environment variables. See docs/deploy.md → Runtime configuration.
#
# Legend:  [required] must be set   ·   [optional] has a working default in engine/config.py


# ─── Database ────────────────────────────────────────────────────────────────────────────
# [required in practice] CockroachDB connection string. The default below points at a local
# single-node cluster; set this to your CockroachDB Cloud URL to use the real cluster.
# Default: postgresql://root@127.0.0.1:26257/defaultdb?sslmode=disable
# Note: use 127.0.0.1 rather than "localhost" — psycopg tries ::1 first and Windows takes
# ~130s to give up when the node listens on IPv4 only (same reason as the canaries).
DATABASE_URL=postgresql://root@127.0.0.1:26257/defaultdb?sslmode=disable


# ─── Models (Amazon Bedrock) ─────────────────────────────────────────────────────────────
# Credentials are NOT environment variables: Bedrock access comes from the AWS credential
# chain (locally `aws configure` / SSO; in ECS the task role, which needs bedrock:InvokeModel).

# [optional] Default: us-east-1
AWS_REGION=us-east-1

# [optional] Extraction / planning / narration model.
# Default: us.anthropic.claude-sonnet-4-20250514-v1:0
# EXTRACTION_MODEL_ID=

# [optional] Embedding model. Default: amazon.titan-embed-text-v2:0
# EMBEDDING_MODEL_ID=

# [optional] Embedding dimensions. MUST match VECTOR(512) in engine/schema.sql — changing
# this without a schema migration breaks inserts. Default: 512
# EMBED_DIMS=512


# ─── Application behavior ────────────────────────────────────────────────────────────────
# [optional] Fallback timezone when the model cannot infer one for an event, and the zone
# aggregation buckets are computed in. Default: Asia/Kolkata
DEFAULT_TZ=Asia/Kolkata

# [optional] Session cookie lifetime in seconds. Default: 1209600 (14 days)
# SESSION_TTL_SECONDS=1209600

# [optional] How many NULL-embedding rows to backfill opportunistically per ingest turn
# (T15). Default: 32
# BACKFILL_BATCH=32


# ─── Tests only ──────────────────────────────────────────────────────────────────────────
# [optional] When set (or when CI=1), a database-backed test FAILS instead of skipping if
# CockroachDB is unreachable — a canary must never silently skip in CI.
# REQUIRE_DB=1

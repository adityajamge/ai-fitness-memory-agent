# AI Fitness Memory Agent — local development configuration
#
# Copy to `.env` and edit. `.env` is gitignored; this template is not.
#   cp .env.example .env
#
# Loaded automatically by engine/config.py when python-dotenv is installed
# (`pip install -e . --group dev`), and by the root conftest.py so tests read the same file the
# app does. Real environment variables always win over this file, so `DATABASE_URL=... pytest`
# still overrides what is written here.
#
# One deliberate exception: the **database** the tests use is not necessarily the one the app
# uses. If DATABASE_URL_TEST_ONLY is set, the suite uses it and the app still uses DATABASE_URL
# — see the Database section below for why.
#
# In production (ECS Express Mode) there is no .env — the task definition supplies these as
# real environment variables. See docs/deploy.md → Runtime configuration.
#
# Legend:  [required] must be set   ·   [optional] has a working default in engine/config.py


# ─── Database ────────────────────────────────────────────────────────────────────────────
# [required in practice] CockroachDB connection string. The default below points at a local
# single-node cluster; set this to your CockroachDB Cloud URL to use the real cluster.
# Default: postgresql://root@127.0.0.1:26257/defaultdb?sslmode=disable
# Note: use 127.0.0.1 rather than "localhost" — psycopg tries ::1 first and Windows takes
# ~130s to give up when the node listens on IPv4 only (same reason as the canaries).
DATABASE_URL=postgresql://root@127.0.0.1:26257/defaultdb?sslmode=disable

# [optional, but REQUIRED if DATABASE_URL points at a cluster holding real data]
# The cluster the **pytest suite** runs against. When set it takes precedence over
# DATABASE_URL for tests only (engine/tests/conftest.py); application and CLI code paths
# (engine/config.py, cli/replay.py, cli/backfill.py, cli/migrate.py) always use DATABASE_URL.
#
# Why this exists: the DB fixtures mint a fresh user_id per test and never clean up, and
# `memories` has no FK to `users` — so ONE full-suite run permanently adds ~228 memories and
# ~30 orphan users. A cluster that accumulated ~9k memories / ~4.7k users stopped passing the
# suite entirely (persistent SerializationFailure on a different random test each run, never an
# assertion failure). Keep the disposable test cluster separate from the one holding the
# replayed personal history, or the replay's verification counts and measurements become
# meaningless. Resolution order in tests: DATABASE_URL_TEST_ONLY → DATABASE_URL → local default
# (the fallback is what keeps CI working — CI sets only DATABASE_URL, to a local Docker node).
# DATABASE_URL_TEST_ONLY=postgresql://...disposable-test-cluster.../defaultdb?sslmode=verify-full


# ─── Model provider selection ────────────────────────────────────────────────────────────
# [optional] Which ModelProvider implementation to build: "bedrock" | "claude_api".
#   bedrock     — the production default (ADR-13). Extraction + planning + narration via
#                 Bedrock Converse, embeddings via Titan V2. Requires AWS credentials.
#   claude_api  — DEVELOPMENT ONLY. Runs the app on a platform.claude.com API key when
#                 Bedrock access isn't available. Cannot embed (the Claude API has no
#                 embeddings endpoint), so memories are stored with NULL embeddings and are
#                 backfilled later via `python -m cli.backfill` against Bedrock. Semantic
#                 recall is unavailable on this provider; every other tool works.
# Default: bedrock
MODEL_PROVIDER=bedrock


# ─── Provider: Bedrock (MODEL_PROVIDER=bedrock) ──────────────────────────────────────────
# Credentials are NOT environment variables: Bedrock access comes from the AWS credential
# chain (locally `aws configure` / SSO; in ECS the task role, which needs bedrock:InvokeModel).

# [optional] Default: us-east-1
AWS_REGION=us-east-1

# [optional] Extraction / planning / narration model.
# Default: us.anthropic.claude-sonnet-4-20250514-v1:0
# EXTRACTION_MODEL_ID=

# [optional] Embedding model. Default: amazon.titan-embed-text-v2:0
# EMBEDDING_MODEL_ID=

# [optional] Embedding dimensions. MUST match VECTOR(512) in engine/schema.sql — changing
# this without a schema migration breaks inserts. Default: 512
# EMBED_DIMS=512


# ─── Provider: Claude API (MODEL_PROVIDER=claude_api) ────────────────────────────────────
# [required when MODEL_PROVIDER=claude_api] Read by the `anthropic` SDK itself, not by
# engine/config.py — so it will not appear in Settings. Without it the SDK raises at the
# first model call and /api/chat returns 502. An `ant auth login` profile also works.
# ANTHROPIC_API_KEY=sk-ant-...

# [optional] Model id. Default: claude-opus-5
# CLAUDE_API_MODEL_ID=claude-opus-5

# [optional] Reasoning effort for extraction, planning, and narration:
# low | medium | high | xhigh | max — or `none` to omit the parameter entirely.
# These are structured, scoped tasks, so the default keeps dev turns fast and cheap;
# raise it if the planner picks poor tools.
# NOTE: effort is MODEL-DEPENDENT. The current Opus/Sonnet/Fable line accepts it; the
# 4.5-era small models (claude-haiku-4-5, claude-sonnet-4-5, claude-3-*) reject it with
# a 400. The provider omits it automatically for those models, so this setting is safe
# to leave at the default whichever model you choose.
# Default: low
# CLAUDE_API_EFFORT=low


# ─── Application behavior ────────────────────────────────────────────────────────────────
# [optional] Fallback timezone when the model cannot infer one for an event, and the zone
# aggregation buckets are computed in. Default: Asia/Kolkata
DEFAULT_TZ=Asia/Kolkata

# [optional] Session cookie lifetime in seconds. Default: 1209600 (14 days)
# SESSION_TTL_SECONDS=1209600

# [optional] How many NULL-embedding rows to backfill opportunistically per ingest turn
# (T15). Default: 32
# BACKFILL_BATCH=32


# ─── Tests only ──────────────────────────────────────────────────────────────────────────
# See also DATABASE_URL_TEST_ONLY in the Database section — that is what keeps the test suite
# off the cluster holding real data. Set it whenever DATABASE_URL is not disposable.

# [optional] When set (or when CI=1), a database-backed test FAILS instead of skipping if
# CockroachDB is unreachable — a canary must never silently skip in CI.
# REQUIRE_DB=1
